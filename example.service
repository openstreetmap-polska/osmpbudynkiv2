# Example systemd unit for the `run` HTTP service.
#
# Install:
#   sudo cp deploy/osmpbudynkiv2.service /etc/systemd/system/
#   sudo useradd --system --home /opt/osmpbudynkiv2 --shell /usr/sbin/nologin osmpbudynkiv2
#   sudo chown -R osmpbudynkiv2:osmpbudynkiv2 /opt/osmpbudynkiv2
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now osmpbudynkiv2
#
# Edit the paths below (User/Group, WorkingDirectory, ExecStart) to match
# your deployment layout first. This file assumes a layout of:
#   /opt/osmpbudynkiv2/
#     osmpbudynkiv2              # release binary (built with `cargo build --release`)
#     config.toml                # copy of example_config.toml with paths made absolute
#     web/                       # copy of the web/ frontend directory
#     osmpbudynkiv2.duckdb       # created by `init`/`import`, run once *before* first start
#     osmpbudynkiv2.rocksdb/    # includes the rendered-tile store: budget ~1.3 GB
#                               # extra for a fully warmed Poland (`tiles warm`)
#
# db_path/rocksdb_path/web_dir in example_config.toml are relative -- they
# resolve against the process's current working directory, which is why
# WorkingDirectory below must match wherever the database and web/ directory
# actually live. Simplest to just make them absolute in config.toml instead.
#
# This unit does not run `init`/`import`/`compare` for you -- run those by
# hand (or from a oneshot unit/timer) as this same user before the first
# `systemctl start`, since `run` expects an already-populated database. Only
# one instance may ever have the database open at a time: DuckDB has no
# multi-writer support, so never run an offline `import`/`update`/`compare`/
# `queue`/`reports` command against the same db_path while this service is
# running -- stop it first.

[Unit]
Description=osmpbudynkiv2 HTTP service (API + web frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osmpbudynkiv2
Group=osmpbudynkiv2
WorkingDirectory=/opt/osmpbudynkiv2
ExecStart=/opt/osmpbudynkiv2/osmpbudynkiv2 --config /opt/osmpbudynkiv2/config.toml run

# Loads plain KEY=VALUE lines (like this repo's root .env) into the unit's
# environment -- no `export`, quoting, or shell expansion, unlike
# scripts/run_release.sh's `source .env`. Leading `-` makes a missing file
# non-fatal. `run` itself doesn't need this repo's TERYT_API_* vars (only
# `import prg`'s TERC download does, an offline step this unit doesn't run)
# -- keep this only if you have other secrets config.toml should pick up,
# e.g. api_username/api_password under [teryt] via their env fallback.
EnvironmentFile=-/opt/osmpbudynkiv2/.env

# RUST_LOG overrides config.toml's log_level if set -- omit to use the
# config value.
# Environment=RUST_LOG=info

# Ctrl+C/SIGTERM is handled by the process itself (a signal handler flips a
# shutdown flag that in-flight background jobs and the HTTP server poll),
# so plain SIGTERM is enough -- no need for SIGKILL or a custom KillSignal.
# Give it real time to finish an in-flight DuckDB statement and drain
# in-flight requests before systemd escalates to SIGKILL.
#
# Generous on purpose, and this is not just politeness to in-flight requests:
# a SIGKILL closes the database *without checkpointing*, which leaves a WAL
# full of inserts into pre-existing RTREE indexes -- exactly the precondition
# for duckdb-spatial issue #861, whose replay bug then breaks index-bound
# queries (every /tiles zoom) on the next open with "Operation requires a flat
# vector but a non-flat vector was encountered". A production instance hit
# that after a 60s timeout proved too short to shut down a process with
# several GB paged out. Raise this further rather than lower it; the cost of
# waiting is seconds, the cost of a dirty WAL is broken tiles until the
# extension is patched. See docs/memory_growth_investigation.md.
TimeoutStopSec=300

# Crash recovery. Not concurrent-writer risk: systemd only starts the new
# process after the old one has fully exited.
Restart=on-failure
RestartSec=5

# Allocator tuning. This process contains *two* jemallocs -- DuckDB's prefixed
# `duckdb_je_*` build and rust-rocksdb's unprefixed one, whose malloc/free
# override glibc's and so back the entire Rust heap (see CLAUDE.md's jemalloc
# gotcha). Both read this same MALLOC_CONF, so one line configures both.
#
# Without it, both run at jemalloc's defaults -- notably `narenas` at 4x the
# CPU count. jemalloc never migrates memory between arenas, so with 34 threads
# (8 pooled DuckDB connections, tokio workers, RocksDB background jobs) each
# arena retains its own high-water mark independently and process RSS ratchets
# upward under bursty allocation without ever coming back down. A production
# instance reached 9.7 GB RSS plus 6 GB of swap over four days with ~9.5 GB of
# that sitting in ~21 sparsely-resident anonymous arenas; see
# docs/memory_growth_investigation.md for the full measurements.
#
# narenas caps that spread; background_thread purges asynchronously so the
# decay settings do not land as latency on a request thread; dirty_decay_ms
# halves jemalloc's 10 s default. muzzy_decay_ms:0 is already jemalloc's
# default and is spelled out only so a later edit does not quietly raise it --
# a higher value delays returning muzzy pages, which is backwards here.
Environment=MALLOC_CONF=narenas:4,background_thread:true,dirty_decay_ms:5000,muzzy_decay_ms:0

# Memory accounting. Pure observability, no behaviour change, and the reason
# to keep it unconditionally: without it
# `systemctl show -p MemoryCurrent osmpbudynkiv2` reads [not set] and there is
# nothing to watch a slow leak with short of poking around in /proc.
MemoryAccounting=true

# Memory ceiling. A backstop against a runaway, NOT a way to squeeze the
# working set -- and the distinction is load-bearing, because getting it wrong
# does not look like a memory error.
#
# MemoryMax is a hard OOM-kill ceiling; combined with Restart=on-failure above,
# exceeding it restarts the service instead of taking the host down. Set it
# from a *measured* baseline, not from a guess: start the service with this
# commented out, let it serve for an hour, read `MemoryCurrent`, and set this
# comfortably (say 2x) above that. It must in any case stay well above
# `memory_limit` in config.toml (4 GB by default), which governs only DuckDB's
# own buffer manager -- not the spatial extension's GEOS allocations, the Rust
# heap, or allocator overhead, all of which are real and none of which DuckDB
# counts.
#
# The value below assumes a 16 GB host and a 4 GB `memory_limit`. Treat it as
# a placeholder to replace, not a default to keep.
MemoryMax=12G

# MemoryHigh is deliberately NOT set here, and it is the setting most likely to
# be reached for by mistake. It does not cap anything: it throttles the cgroup
# and reclaims aggressively once crossed, so a value below the real working set
# does not fail loudly -- it just makes every DuckDB query slow. Set 2 GB too
# low on a live instance, the symptom was the r2d2 pool exhausting within 40
# seconds of startup and every endpoint logging
# "Failed to acquire pool connection", with nothing anywhere naming memory as
# the cause. If you do want a soft brake, set it only after you know the
# steady-state figure, and read
# /sys/fs/cgroup/system.slice/<unit>/memory.events afterwards -- a climbing
# `high` counter means it is throttling.
# MemoryHigh=10G

# Swap is deliberately left alone (no MemorySwapMax). Denying swap outright
# makes the ceiling above bind more predictably, but it also removes the slack
# that lets a shutdown complete -- and an incomplete shutdown means a SIGKILL,
# a dirty WAL, and the #861 breakage described at TimeoutStopSec above. If the
# host is swapping *steadily* that is a problem to fix at its source, not to
# paper over here.

# Basic hardening. Tighten/extend ReadWritePaths if you move the database,
# RocksDB directory, or `download_dir` outside WorkingDirectory.
#
# Downloaded files (OSM/BDOT10k/EGIB/PRG snapshots fetched by the
# jobs.*_update background jobs) need no entry here even though
# `download_dir` defaults to unset: PrivateTmp already gives this unit its
# own writable /tmp regardless of ProtectSystem=strict, and that's what an
# unset download_dir falls back to. Only add a path if you set download_dir
# explicitly to somewhere outside WorkingDirectory.
#
# DuckDB extensions (INSTALL spatial/icu, run on every startup via
# duckdb_init_commands) install to $HOME/.duckdb/extensions, not
# WorkingDirectory. HOME is pinned below to keep that inside
# ReadWritePaths -- without it, HOME would come from this user's passwd
# entry, so a differently-created system user (e.g. one whose home is `/`
# or `/nonexistent`, common for auto-generated system accounts) would fail
# `INSTALL spatial` with a permission error on every startup, since spatial
# can't be statically linked into the binary (see CLAUDE.md).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=HOME=/opt/osmpbudynkiv2
ReadWritePaths=/opt/osmpbudynkiv2

[Install]
WantedBy=multi-user.target
